@@ -0,0 +1,24 @@
+import type { HelperInstaller } from './helper/installer'
+import { existsSync, readFileSync } from 'node:fs'
+
+export const NIXOS_HELPER_INSTRUCTIONS =
+  'Enable programs.metacubexd-desktop.tunMode and set programs.metacubexd-desktop.user to your login, then rebuild NixOS. Manage the helper with NixOS, not the in-app installer.'
+
+export function readNixosHelperSecret(secretFile: string): string {
+  try {
+    const secret = readFileSync(secretFile, 'utf8').trim()
+    if (secret) return secret
+  } catch {
+    // Proxy-only operation remains available without the optional helper.
+  }
+  throw new Error(NIXOS_HELPER_INSTRUCTIONS)
+}
+
+export function createNixosHelperInstaller(socketPath: string): HelperInstaller {
+  return {
+    isInstalled: async () => existsSync(socketPath),
+    installedVersion: async () => undefined,
+    install: async () => { throw new Error(NIXOS_HELPER_INSTRUCTIONS) },
+    uninstall: async () => { throw new Error(NIXOS_HELPER_INSTRUCTIONS) },
+  }
+}
--- /dev/null
+++ b/apps/desktop/src/main/__tests__/nixos-helper.spec.ts
@@ -0,0 +1,32 @@
+import { mkdtempSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, describe, expect, it } from 'vitest'
+import { createNixosHelperInstaller, readNixosHelperSecret } from '../nixos-helper'
+
+const directory = mkdtempSync(join(tmpdir(), 'mcxd-nixos-'))
+afterEach(() => rmSync(join(directory, 'secret'), { force: true }))
+
+describe('NixOS helper integration', () => {
+  it('rereads the token after a service restart', () => {
+    const file = join(directory, 'secret')
+    writeFileSync(file, 'first\n')
+    expect(readNixosHelperSecret(file)).toBe('first')
+    writeFileSync(file, 'second\n')
+    expect(readNixosHelperSecret(file)).toBe('second')
+  })
+
+  it('reports how to enable the module for missing and empty tokens', () => {
+    const file = join(directory, 'secret')
+    expect(() => readNixosHelperSecret(file)).toThrow('programs.metacubexd-desktop.tunMode')
+    writeFileSync(file, '')
+    expect(() => readNixosHelperSecret(file)).toThrow('programs.metacubexd-desktop.tunMode')
+  })
+
+  it('never installs or removes a declarative service', async () => {
+    const installer = createNixosHelperInstaller(join(directory, 'missing.sock'))
+    expect(await installer.isInstalled()).toBe(false)
+    await expect(installer.install({} as never)).rejects.toThrow('rebuild NixOS')
+    await expect(installer.uninstall()).rejects.toThrow('rebuild NixOS')
+  })
+})
